{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticketer",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-10",
  "observability": {
    "enabled": true,
  },
  "assets": {
  "directory": "./dist",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application"
},
  "compatibility_flags": ["nodejs_compat"],
}
